module

public import NearCritical.Section9ConditionalExpectation
public import NearCritical.Section9AdaptivePivotalCount

/-! Actual reveal sigma-algebra and conditional expectation of the actual
adaptive pivot count. Target sets here are fixed before conditioning. -/
@[expose] public section
noncomputable section
namespace NearCritical
open MeasureTheory ProbabilityTheory
open scoped Classical

lemma measurable_section9HeartObservation {d : ℕ} (Q H : Finset (Vertex d))
    (hH : H ⊆ Q) : Measurable (fun ω : Configuration d => heartClusterUnion ω Q H) := by
  apply measurable_to_countable'
  intro F
  exact measurableSet_section9HeartReveal Q H F hH

lemma measurable_section9PairObservation {d : ℕ} (Q₁ H₁ Q₃ H₃ : Finset (Vertex d))
    (hH₁ : H₁ ⊆ Q₁) (hH₃ : H₃ ⊆ Q₃) :
    Measurable (fun ω : Configuration d =>
      (heartClusterUnion ω Q₁ H₁, heartClusterUnion ω Q₃ H₃)) :=
  (measurable_section9HeartObservation Q₁ H₁ hH₁).prodMk
    (measurable_section9HeartObservation Q₃ H₃ hH₃)

/-- Conditional expectation with respect to the sigma-algebra generated by
both actual heart unions equals the mean computed in the actual revealed law.
No positive-atom hypothesis is imposed on a realized observation. -/
theorem section9_condExp_adaptive_eq_revealed_mean {d : ℕ} (p : unitInterval)
    (E : Finset (Vertex d × Vertex d)) (L R Q₁ H₁ Q₃ H₃ A B : Finset (Vertex d))
    (hH₁ : H₁ ⊆ Q₁) (hH₃ : H₃ ⊆ Q₃) :
    (percolation d p)[section9AdaptivePivotalCount E L R Q₁ H₁ Q₃ H₃ A B |
      (inferInstance : MeasurableSpace (Finset (Vertex d) × Finset (Vertex d))).comap
        (fun ω => (heartClusterUnion ω Q₁ H₁, heartClusterUnion ω Q₃ H₃))] =ᵐ[percolation d p]
      fun ω => section9PivotalMean
        (section9RevealedLaw p Q₁ H₁ Q₃ H₃
          (heartClusterUnion ω Q₁ H₁) (heartClusterUnion ω Q₃ H₃))
        E L R Q₁ (heartClusterUnion ω Q₁ H₁) Q₃ (heartClusterUnion ω Q₃ H₃) A B := by
  have h := section9_condExp_eq_fiber_integral (percolation d p)
    (fun ω => (heartClusterUnion ω Q₁ H₁, heartClusterUnion ω Q₃ H₃))
    (measurable_section9PairObservation Q₁ H₁ Q₃ H₃ hH₁ hH₃)
    (section9AdaptivePivotalCount E L R Q₁ H₁ Q₃ H₃ A B)
    (integrable_section9AdaptivePivotalCount (percolation d p) E L R Q₁ H₁ Q₃ H₃ A B hH₁ hH₃)
  filter_upwards [h] with ω hω
  rw [hω]
  have hfiber : {z : Configuration d |
      (heartClusterUnion z Q₁ H₁, heartClusterUnion z Q₃ H₃) =
        (heartClusterUnion ω Q₁ H₁, heartClusterUnion ω Q₃ H₃)} =
      section9RevealEvent Q₁ H₁ Q₃ H₃
        (heartClusterUnion ω Q₁ H₁) (heartClusterUnion ω Q₃ H₃) := by
    ext z
    simp only [Set.mem_setOf_eq, Prod.mk.injEq, section9RevealEvent]
  rw [hfiber]
  exact integral_section9AdaptivePivotalCount_revealed p E L R Q₁ H₁
    (heartClusterUnion ω Q₁ H₁) Q₃ H₃ (heartClusterUnion ω Q₃ H₃) A B hH₁ hH₃

end NearCritical
